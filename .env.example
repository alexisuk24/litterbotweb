# Copy to .env next to compose.yml and fill in. Never commit .env.
# These are the variables compose.yml reads; the values shown are its defaults. For the other
# settings in the README (retention, clip matching, LR_WEB, ...), add them to the service's
# environment in compose.yml.

# Whisker account (required)
LR_USERNAME=you@example.com
LR_PASSWORD=change-me

# Timezone for logs and schedules, e.g. Europe/London
TZ=UTC

# Host folders for the clips and the database/logs (must be owned by uid/gid 1000)
CLIPS_DIR=./clips
DATA_DIR=./data

# Seconds between sync runs, until a schedule is picked under Settings > Sync schedule
LR_DOWNLOAD_INTERVAL=3600
# Seconds between robot status checks, to fetch a visit soon after its clean cycle (0 = off)
LR_STATUS_INTERVAL=60
# Seconds between checks for pylitterbot updates
PYBOT_UPDATE_INTERVAL=86400
# Pages of 100 activities to backfill on the first run
LR_ACTIVITY_MAX_PAGES=50

# Encoder for clips that switch cameras: auto, vaapi or off
LR_HWACCEL=auto
# Host's render group id, for VAAPI (getent group render | cut -d: -f3); also uncomment
# devices and group_add in compose.yml
RENDER_GID=109

# Access control with Cloudflare Access (see README). Leave empty to turn roles off.
LR_AUTH_HEADER=
LR_AUTH_TEAM_DOMAIN=
LR_AUTH_AUD=
LR_ADMINS=
